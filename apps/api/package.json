{
  "name": "@homework/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "npm run build --workspace @homework/contracts && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace @homework/contracts && tsc -p tsconfig.json --noEmit",
    "test": "vitest run src test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@homework/contracts": "^0.1.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "docx": "^9.5.1",
    "fflate": "^0.8.2",
    "file-type": "^22.3.0",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@electric-sql/pglite-socket": "^0.1.3",
    "@types/multer": "^2.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.21.0"
  }
}
